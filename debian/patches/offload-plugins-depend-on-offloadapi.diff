Description: Ensure offload plugins depend on OffloadAPI tablegen target
 The plugin libraries (omptarget.rtl.host, omptarget.rtl.cuda,
 omptarget.rtl.amdgpu, omptarget.rtl.level_zero) include OffloadAPI.h,
 a header generated by the OffloadAPI custom target in
 offload/liboffload/API. PluginCommon propagates the include path
 via PUBLIC target_include_directories, but no build-order dependency
 on OffloadAPI is set up, so on parallel builds rtl.cpp can be
 compiled before the header has been generated, producing:
 .
   fatal error: 'OffloadAPI.h' file not found
 .
 add_subdirectory(plugins-nextgen) runs before add_subdirectory(liboffload)
 in offload/CMakeLists.txt, so the OffloadAPI target does not yet exist
 while the plugins are configured. Wire up the missing dependency once
 both subdirectories have been processed.
 .
 Related upstream commit (different but related issue):
 817af2ddf24bd6ef68d66d86904d0682dd5feda9
Bug: https://github.com/llvm/llvm-project/issues/196690
Bug: https://github.com/llvm/llvm-project/issues/142756
Forwarded: no
Author: Sylvestre Ledru <sylvestre@debian.org>

Index: llvm-toolchain-snapshot_23~++20260522073151+ec4681df3d6b/offload/CMakeLists.txt
===================================================================
--- llvm-toolchain-snapshot_23~++20260522073151+ec4681df3d6b.orig/offload/CMakeLists.txt
+++ llvm-toolchain-snapshot_23~++20260522073151+ec4681df3d6b/offload/CMakeLists.txt
@@ -302,6 +302,19 @@ add_subdirectory(libomptarget)
 
 add_subdirectory(liboffload)
 
+# The plugin runtimes (omptarget.rtl.<plugin>) include OffloadAPI.h, which is
+# generated by the OffloadAPI tablegen target inside liboffload/API. Because
+# plugins-nextgen is processed before liboffload, the plugins cannot reference
+# OffloadAPI at the time they are created. Wire up the dependency here so that
+# the generated headers are produced before any plugin source is compiled.
+if(TARGET OffloadAPI)
+    foreach(plugin IN LISTS LIBOMPTARGET_PLUGINS_TO_BUILD)
+        if(TARGET omptarget.rtl.${plugin})
+            add_dependencies(omptarget.rtl.${plugin} OffloadAPI)
+        endif()
+    endforeach()
+endif()
+
 # Add tests.
 if(OFFLOAD_INCLUDE_TESTS)
   add_subdirectory(test)
